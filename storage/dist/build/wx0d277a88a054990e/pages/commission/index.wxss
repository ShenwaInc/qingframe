page{background-color:#fff}.user-card>.cu-item{padding-left:190rpx!important;background:none!important;width:100%}.user-card>.cu-item:last-child:after{display:none}.user-card>.cu-item .text-bold{font-size:34rpx;font-family:PingFangSC-Medium,PingFang SC}.user-card>.cu-item .text-content{padding-top:16rpx;font-size:26rpx;line-height:48rpx;min-height:70rpx;max-height:165rpx;overflow:hidden}.user-card>.cu-item .cu-avatar.xl~.content{min-height:128rpx;left:0!important}.user-card>.cu-item .content .right{position:absolute;right:0;top:0}.user-card>.cu-item .content .title{font-size:1.06rem!important;font-weight:600;line-height:60rpx;padding-top:15rpx}.user-card>.cu-item .content .title~.text-content{padding-top:0;font-size:30rpx;min-height:unset}.shadow-outside .cu-item{margin-bottom:15rpx}.shadow-outside .cu-item .image{width:120rpx;height:120rpx;margin:0 auto;margin-bottom:.4rem}.shadow-outside .cu-item .image image{max-height:100%}.cu-list .cu-item .content{max-width:calc(100% - 230rpx)}
