.head{width:100%;min-height:320rpx;overflow:hidden}.mode0{padding-bottom:60rpx}.round-square{background-color:rgba(55,55,55,.1);padding:40rpx;border-radius:50%}.round-square .cuIcon-safe{font-size:72rpx}.cu-form-group .title{min-width:calc(4em + 15px)}.cu-form-group~.cu-bar:not(.no-border){border-top:.5px solid #eee}.type-grid{display:flex;flex-wrap:wrap;gap:40rpx;padding:20rpx 0}.type-item{width:calc(50% - 20rpx);background:#fff;overflow:hidden;transition:all .3s ease;border:2rpx solid transparent}.type-item:active{transform:scale(.96);box-shadow:0 4rpx 16rpx rgba(0,0,0,.12)}.type-content{padding:48rpx 24rpx;text-align:center}.type-icon{width:88rpx;height:88rpx;margin:0 auto 24rpx;border-radius:50%;background:linear-gradient(135deg,#f8f9fa,#e9ecef);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 4rpx 12rpx rgba(0,0,0,.1)}.type-icon image{width:100%;height:100%;border-radius:50%;object-fit:cover}.type-icon .cuIcon-safe{font-size:44rpx}.type-name{font-size:30rpx;font-weight:600;line-height:1.4;letter-spacing:.5rpx}.cu-list.menu .cu-item .action{max-width:60%;word-break:break-all}.cu-list.menu .cu-item .action .text-grey{text-align:right}.cuIcon-file,.cuIcon-picfill{font-size:40rpx}.cu-list.menu .cu-item .action .text-grey.long-text{text-align:left;white-space:normal;line-height:1.5}
