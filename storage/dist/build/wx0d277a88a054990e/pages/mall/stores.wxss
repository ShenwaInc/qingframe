page{background-color:#fff}.head{position:relative;overflow:hidden}.head-img{position:absolute;width:100%;top:0;left:0;min-height:100%}.bg-shadeBottom{background-image:linear-gradient(rgba(255,255,255,.01),#fff);position:relative;height:30rpx;margin-top:-10rpx}.tags-list{white-space:nowrap}.tags-list .cu-tag+.cu-tag{margin-left:15rpx}.head.map{height:100vh}.map-list{width:100vh;position:relative}.map-item{position:absolute;z-index:999;bottom:100rpx;left:0;overflow:hidden;width:780rpx}.head>.padding{padding-top:80rpx}.image-pic{background-size:cover;background-repeat:no-repeat;background-position:top;background-color:#dedede;border-radius:10rpx}.article-content{display:flex;flex-direction:column;justify-content:space-between;max-width:calc(100% - 180rpx);overflow:hidden}.article-shadow{border-radius:15rpx;box-shadow:0 0 50rpx rgba(0,0,0,.07)}.clamp-text-1{-webkit-line-clamp:1;display:-webkit-box;-webkit-box-orient:vertical;text-overflow:ellipsis;overflow:hidden}.clamp-text-2{-webkit-line-clamp:2;display:-webkit-box;-webkit-box-orient:vertical;text-overflow:ellipsis;overflow:hidden}.image-pic{margin-right:0rpx;height:180rpx}.image-article{position:relative;width:180rpx;height:180rpx}.article-summary{min-height:68rpx}.article-tag{width:25%}.merchant-item{border-bottom:1rpx solid #DEDEDE}.merchant-list .merchant-item:last-child{border:none}.map-item .image-pic{width:132rpx;height:132rpx}.map-item .article-content{max-width:calc(100% - 132rpx)}.merchant-action{position:fixed;right:0;bottom:100rpx;padding:30rpx;text-align:right;z-index:999}.merchant-action.hasBar{bottom:180rpx}.mall-order{width:100rpx;height:100rpx;overflow:hidden;display:inline-block}.mall-order .bg-white{width:100%;height:100%;line-height:32rpx;font-size:26rpx;padding-top:16rpx}.merchant-action .round+.round{margin-top:30rpx}.mall-join{height:100rpx;overflow:hidden;line-height:100rpx}.mall-join .bg-white{padding:0 20rpx}.page-map .mall-join{width:150rpx}
