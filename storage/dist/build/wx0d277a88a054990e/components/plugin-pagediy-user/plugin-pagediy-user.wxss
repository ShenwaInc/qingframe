._user-top{display:flex;position:relative;background-size:cover;height:350rpx}._user-top image,._user-top-name,._user-top-phone,._user-top-integral{position:absolute}._user-top image{width:100rpx;border-radius:100%}._user-top-name{font-size:28rpx}._user-top-phone{font-size:24rpx}._user-top-refresh{font-size:38rpx}._user-top-integral{display:flex;align-items:center;justify-content:center;left:0;bottom:0;width:100%;height:100rpx;background:rgba(0,0,0,.1)}._user-top-integral button{text-align:center;width:50vw}._user-top-integral button:last-child{text-align:center;width:calc(50vw - 1px)}._user-top-integral .integral-title{font-size:24rpx}._user-top-integral .integral-line{text-align:center;height:50%;width:1px;opacity:.5;background:#fff}._user-top-integral .integral-number{padding-top:5rpx;font-size:32rpx}
