.uni-transition{transition-timing-function:ease;transition-duration:.3s;transition-property:transform,opacity}.fade-in{opacity:0}.fade-active{opacity:1}.slide-top-in{transform:translateY(-100%)}.slide-top-active{transform:translateY(0)}.slide-right-in{transform:translate(100%)}.slide-right-active{transform:translate(0)}.slide-bottom-in{transform:translateY(100%)}.slide-bottom-active{transform:translateY(0)}.slide-left-in{transform:translate(-100%)}.slide-left-active{transform:translate(0);opacity:1}.zoom-in-in{transform:scale(.8)}.zoom-out-active{transform:scale(1)}.zoom-out-in{transform:scale(1.2)}
