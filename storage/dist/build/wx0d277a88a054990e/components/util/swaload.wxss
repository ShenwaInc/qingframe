.swaloading{position:absolute;z-index:998;width:100%;height:100%;top:0;left:0}.skeleton-container{padding:20px}.skeleton-title{margin-bottom:20px}.skeleton-line{display:inline-block;width:100%;height:20px;background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0,#f0f0f0 75%);background-size:200% 100%;animation:loading 3s infinite ease-in-out}@keyframes loading{0%{background-position:200% 0}50%{background-position:0 0}to{background-position:-200% 0}}.skeleton-image{margin-bottom:20px}.skeleton-image-placeholder{width:100%;height:200px;background-color:#e0e0e0;border-radius:8px}.skeleton-content{display:flex;flex-direction:column}.skeleton-item{margin-bottom:10px}.skeleton-shape{height:10px;width:80%;background-color:#d0d0d0;margin-bottom:10px}.skeleton-shape-round{height:20px;width:20px;background-color:silver;border-radius:50%;margin-bottom:10px}.skeleton-separator{height:10px;background-color:#b0b0b0;margin-bottom:20px}
